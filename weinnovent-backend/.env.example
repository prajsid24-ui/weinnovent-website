# ============================================================
# WEINNOVENT BACKEND — ENVIRONMENT VARIABLES
# Copy this to .env and fill in all values
# NEVER commit .env to git
# ============================================================

# --- Server ---
PORT=3000
NODE_ENV=production

# --- Meta WhatsApp Cloud API ---
# From: developers.facebook.com → Your App → WhatsApp → API Setup
WHATSAPP_TOKEN=your_permanent_access_token_here
WHATSAPP_PHONE_NUMBER_ID=your_phone_number_id_here
WHATSAPP_BUSINESS_ACCOUNT_ID=your_waba_id_here

# Webhook verification token — make up any random string
WEBHOOK_VERIFY_TOKEN=weinnovent_webhook_secret_2024

# --- Google Sheets/Docs ---
# From: console.cloud.google.com → Service Accounts → JSON key
GOOGLE_SERVICE_ACCOUNT_EMAIL=your-service-account@your-project.iam.gserviceaccount.com
GOOGLE_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\nYOUR_KEY_HERE\n-----END RSA PRIVATE KEY-----"

# Google Sheet ID (from the sheet URL)
# URL format: docs.google.com/spreadsheets/d/SHEET_ID/edit
LEADS_SHEET_ID=your_google_sheet_id_here

# Google Doc ID for weekly reports (from doc URL)
REPORTS_DOC_ID=your_google_doc_id_here

# --- Weinnovent Branding ---
BRAND_NAME=Weinnovent Studios
BRAND_PHONE=your_whatsapp_business_number  # e.g. 919876543210 (with country code, no +)
ADMIN_PHONE=919876543210                    # Your personal number to receive alerts
